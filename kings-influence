<style>
  :root{
    --bg: #FAFAF7;
    --bg-alt: #F1F0EA;
    --ink: #14181F;
    --ink-soft: #5B6069;
    --line: #E1DFD8;
    --signal: #2451C4;
    --signal-soft: #E7ECFA;
    --ember: #C77D2E;
    --ember-soft: #F5E8D8;
    --radius: 4px;
    --max: 980px;
  }
  *{ box-sizing: border-box; margin:0; padding:0; }
  html{ scroll-behavior: smooth; }
  body{
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a{ color: inherit; }
