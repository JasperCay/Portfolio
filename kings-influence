<script>
  // Illustrative placeholder coefficients — replace with real regression
  // output once the R model is trained on the project dataset.
  const coefficients = {
    winOdds: { intercept: 2.0, winPct: 0.15, market: 0.8, tenure: 1.2 },
    valuation: { intercept: 3.0, winPct: 0.05, market: 1.5, tenure: 0.9 }
  };

  const winPctInput = document.getElementById('winPct');
  const marketInput = document.getElementById('market');
  const tenureInput = document.getElementById('tenure');

  function updateCalculator(){
    const winPct = Number(winPctInput.value);
    const market = Number(marketInput.value);
    const tenure = Number(tenureInput.value);

    document.getElementById('winPctVal').textContent = winPct + '%';
    document.getElementById('marketVal').textContent = market;
    document.getElementById('tenureVal').textContent = tenure;

    const wc = coefficients.winOdds;
    const winPctContribution = winPct * wc.winPct;
    const marketContribution = market * wc.market;
    const tenureContribution = tenure * wc.tenure;
    const winOddsTotal = wc.intercept + winPctContribution + marketContribution + tenureContribution;

    const vc = coefficients.valuation;
    const valuationTotal = vc.intercept + (winPct * vc.winPct) + (market * vc.market) + (tenure * vc.tenure);

    document.getElementById('winOddsResult').textContent = '+' + winOddsTotal.toFixed(1) + ' pts';
    document.getElementById('valuationResult').textContent = '+' + valuationTotal.toFixed(1) + '%';

    document.getElementById('bd-intercept').textContent = wc.intercept.toFixed(2);
    document.getElementById('bd-winpct').textContent = winPct + ' × ' + wc.winPct + ' = ' + winPctContribution.toFixed(2);
    document.getElementById('bd-market').textContent = market + ' × ' + wc.market + ' = ' + marketContribution.toFixed(2);
    document.getElementById('bd-tenure').textContent = tenure + ' × ' + wc.tenure + ' = ' + tenureContribution.toFixed(2);
  }

  [winPctInput, marketInput, tenureInput].forEach(input => {
    input.addEventListener('input', updateCalculator);
  });

  updateCalculator();
</script>

<script>
  // Draws the arrow from the Cleveland line in the "per city" chart to the
  // matching spot in the zoomed Cleveland chart. Coordinates below are
  // fixed FRACTIONS of each image's own natural width/height (measured
  // once from the source charts), so they stay accurate at any screen
  // size — we just re-measure the rendered image boxes on load/resize.
  const START_FRAC = { x: 0.588, y: 0.819 }; // Cleveland line, end of per-city chart
  const END_FRAC   = { x: 0.156, y: 0.550 }; // matching point in the zoomed chart
  const SHRINK = 0.22; // pulls both ends inward this % of the total span, to shorten the line

  function updateArrow(){
    const container = document.getElementById('chartPairWide');
    const img1 = document.getElementById('chartImg1');
    const img2 = document.getElementById('chartImg2');
    const svg = document.getElementById('pointerSvg');
    const path = document.getElementById('pointerPath');
    if(!container || !img1 || !img2 || !svg || !path) return;
    if(!img1.complete || !img2.complete) return;

    const cRect = container.getBoundingClientRect();
    const r1 = img1.getBoundingClientRect();
    const r2 = img2.getBoundingClientRect();

    let sx = (r1.left - cRect.left) + START_FRAC.x * r1.width;
    let sy = (r1.top - cRect.top) + START_FRAC.y * r1.height;
    let ex = (r2.left - cRect.left) + END_FRAC.x * r2.width;
    let ey = (r2.top - cRect.top) + END_FRAC.y * r2.height;

    const dx = ex - sx, dy = ey - sy;
    sx += dx * SHRINK; sy += dy * SHRINK;
    ex -= dx * SHRINK; ey -= dy * SHRINK;

    const midX = (sx + ex) / 2;

    svg.setAttribute('viewBox', `0 0 ${cRect.width} ${cRect.height}`);
    path.setAttribute('d', `M ${sx} ${sy} C ${midX} ${sy}, ${midX} ${ey}, ${ex} ${ey}`);
  }

  window.addEventListener('load', updateArrow);
  window.addEventListener('resize', updateArrow);
  document.getElementById('chartImg1')?.addEventListener('load', updateArrow);
  document.getElementById('chartImg2')?.addEventListener('load', updateArrow);
  updateArrow();
</script>
