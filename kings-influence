<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The King's Influence — Jasper Cayunda</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #FAFAF7;
    --bg-alt: #F1F0EA;
    --ink: #14181F;
    --ink-soft: #5B6069;
    --line: #E1DFD8;
    --signal: #2451C4;
    --signal-soft: #E7ECFA;
    --ember: #C77D2E;
    --ember-soft: #F5E8D8;
    --radius: 4px;
    --max: 980px;
  }
  *{ box-sizing: border-box; margin:0; padding:0; }
  html{ scroll-behavior: smooth; }
  body{
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a{ color: inherit; }
  ::selection{ background: var(--signal-soft); color: var(--signal); }
  :focus-visible{ outline: 2px solid var(--signal); outline-offset: 3px; }
  .wrap{ max-width: var(--max); margin: 0 auto; padding: 0 32px; }
  .eyebrow{
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .eyebrow::before{ content: ""; width: 22px; height: 1px; background: var(--signal); display: inline-block; }
  .eyebrow.ember{ color: var(--ember); }
  .eyebrow.ember::before{ background: var(--ember); }
  h1, h2, h3{ font-family: 'Fraunces', serif; font-weight: 600; letter-spacing: -0.01em; line-height: 1.08; }

  /* header */
  header{
    position: sticky; top: 0; z-index: 50;
    background: rgba(250, 250, 247, 0.85);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner{
    max-width: var(--max); margin: 0 auto; padding: 18px 32px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .back-link{
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    text-decoration: none;
    color: var(--ink-soft);
    display: flex; align-items: center; gap: 8px;
    transition: color 0.15s ease;
  }
  .back-link:hover{ color: var(--ink); }
  .logo{ font-family: 'Fraunces', serif; font-weight: 600; font-size: 18px; }
  .logo span{ color: var(--signal); }

  /* hero */
  .case-hero{ padding: 80px 0 60px; }
  .status-banner{
    display: inline-flex; align-items: center; gap: 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; letter-spacing: 0.04em;
    color: var(--ember); background: var(--ember-soft);
    padding: 8px 14px; border-radius: 20px; margin-bottom: 28px;
  }
  .status-banner::before{
    content: ""; width: 7px; height: 7px; border-radius: 50%;
    background: var(--ember); display: inline-block;
  }
  .case-hero h1{ font-size: clamp(38px, 5.2vw, 60px); margin: 20px 0 22px; max-width: 16ch; }
  .case-hero p.lede{ font-size: 18px; color: var(--ink-soft); max-width: 60ch; }

  .meta-row{
    display: flex; gap: 40px; flex-wrap: wrap;
    margin-top: 40px; padding-top: 28px; border-top: 1px solid var(--line);
  }
  .meta-item .meta-label{
    font-family: 'JetBrains Mono', monospace; font-size: 11px;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft);
    margin-bottom: 6px;
  }
  .meta-item .meta-value{ font-family: 'Fraunces', serif; font-size: 17px; }

  section{ padding: 70px 0; }
  .section-alt{ background: var(--bg-alt); }
  .section-head{ margin-bottom: 44px; }
  .section-head h2{ font-size: clamp(26px, 3.2vw, 34px); margin-top: 14px; }
  .section-head p{ color: var(--ink-soft); max-width: 60ch; margin-top: 12px; }

  /* timeline — genuine sequence, so numbering is earned here */
  .timeline{ border-top: 1px solid var(--line); }
  .timeline-row{
    display: grid; grid-template-columns: 70px 160px 1fr;
    gap: 24px; align-items: baseline;
    padding: 22px 0; border-bottom: 1px solid var(--line);
  }
  .timeline-row .t-num{
    font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--signal);
  }
  .timeline-row .t-years{
    font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--ink-soft);
  }
  .timeline-row .t-team{ font-family: 'Fraunces', serif; font-size: 19px; font-weight: 600; }
  .timeline-row .t-note{ color: var(--ink-soft); font-size: 14px; margin-top: 4px; }

  /* finding block */
  .finding{
    display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 48px;
    padding: 56px 0; border-bottom: 1px solid var(--line);
    align-items: start;
  }
  .finding:last-child{ border-bottom: none; }
  .finding-stat{
    background: var(--bg); border: 1px dashed var(--line);
    border-radius: var(--radius); padding: 32px;
  }
  .finding-stat .stat-number{
    font-family: 'Fraunces', serif; font-size: 44px; color: var(--ink-soft);
    font-style: italic;
  }
  .finding-stat .stat-label{
    font-family: 'JetBrains Mono', monospace; font-size: 12px;
    color: var(--ink-soft); margin-top: 8px; letter-spacing: 0.03em;
  }
  .finding-chart{
    margin-top: 20px; aspect-ratio: 16/9;
    border: 1px dashed var(--line); border-radius: var(--radius);
    display: flex; align-items: center; justify-content: center;
    font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--ink-soft);
    text-align: center; padding: 16px;
  }
  .finding-body h3{ font-size: 24px; margin-bottom: 14px; }
  .finding-body p{ color: var(--ink-soft); font-size: 15px; }
  .finding-body p + p{ margin-top: 14px; }
  .finding-body p.placeholder-copy{
    font-style: italic; color: #9A9DA3;
  }
  .source-tag{
    display: inline-block; margin-top: 18px;
    font-family: 'JetBrains Mono', monospace; font-size: 11px;
    color: var(--signal); background: var(--signal-soft);
    padding: 5px 10px; border-radius: 20px;
  }

  /* takeaways */
  .takeaways-box{
    border: 1px dashed var(--line); border-radius: var(--radius);
    padding: 40px; text-align: center;
  }
  .takeaways-box p{ font-family: 'Fraunces', serif; font-style: italic; font-size: 20px; color: var(--ink-soft); max-width: 50ch; margin: 0 auto; }

  footer{ border-top: 1px solid var(--line); padding: 28px 0; }
  .footer-inner{
    display: flex; justify-content: space-between; align-items: center;
    font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--ink-soft);
    flex-wrap: wrap; gap: 12px;
  }
  .footer-inner a{ text-decoration: none; border-bottom: 1px solid var(--ink-soft); }
  .footer-inner a:hover{ color: var(--signal); border-color: var(--signal); }

  @media (max-width: 780px){
    .finding{ grid-template-columns: 1fr; }
    .timeline-row{ grid-template-columns: 40px 1fr; }
    .timeline-row .t-years{ grid-column: 2; order: 2; }
    .meta-row{ gap: 24px; }
  }
</style>
</head>
